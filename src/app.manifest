<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="NeuroMicrophone.app"/>

  <!--
    asInvoker (без запроса повышения при каждом запуске): большая часть
    приложения (захват/вывод звука, горячие клавиши, трей, настройки)
    прав администратора не требует. Административные права нужны только
    для конкретных операций установки/удаления драйвера — DriverInstaller
    запрашивает повышение "по требованию" через verb=runas именно на время
    вызова pnputil, а не для всего приложения сразу.

    ВАЖНО: requireAdministrator здесь намеренно НЕ используется — помимо
    того, что тогда установщику не удаётся запустить приложение обычным
    способом сразу после установки (ошибка Windows 740, "требуется
    повышение"), это ещё и ломает автозапуск с Windows: приложения,
    манифест которых требует администратора, при входе в систему через
    обычный ключ реестра HKCU\...\Run операционной системой просто не
    запускаются (Windows не показывает UAC-запрос в контексте автозапуска).
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 10 / Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
